# Copy to .env and adjust. .env is gitignored.
DEBUG=True
DJANGO_SECRET_KEY=change-me-in-production
DB_NAME=jranalytics
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
LLM_SERVICE_URL=http://127.0.0.1:8001
LLM_TIMEOUT_SECONDS=120

# Gmail account used to send password-reset emails. EMAIL_HOST_PASSWORD is a Gmail
# "App Password" (myaccount.google.com/apppasswords) — NOT your normal Gmail password.
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
